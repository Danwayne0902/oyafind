APP_NAME=OyaFind
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://oyafind.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oyafind
DB_USERNAME=
DB_PASSWORD=
# Optional explicit MySQL connection override:
# MYSQL_DATABASE=oyafind

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@oyafind.test"
MAIL_FROM_NAME="${APP_NAME}"
# Add the SMTP username and password from Mailtrap Email Testing > Sandboxes >
# My Sandbox > Integration > SMTP. Do not use an API token here.

# Local-only convenience for moving through the app without email delivery.
# The contact remains unverified, and saving opportunities stays unavailable.
OYAFIND_ACCOUNT_REGISTRATION=true
OYAFIND_LOCAL_REGISTRATION_WITHOUT_VERIFICATION=true
# OYAFIND_LISTING_SUBMISSION=
# OYAFIND_LOCATION_CATALOGUE=
# OYAFIND_NOTIFICATIONS=

VITE_APP_NAME="${APP_NAME}"
