APP_NAME=OyaFind
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://oyafind.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oyafind
DB_USERNAME=
DB_PASSWORD=
# Optional explicit MySQL connection override:
# MYSQL_DATABASE=oyafind

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@oyafind.test"
MAIL_FROM_NAME="${APP_NAME}"
# Add the SMTP username and password from Mailtrap Email Testing > Sandboxes >
# My Sandbox > Integration > SMTP. Do not use an API token here.

# Local-only convenience for moving through the app without email delivery.
# The contact remains unverified, and saving opportunities stays unavailable.
OYAFIND_ACCOUNT_REGISTRATION=true
OYAFIND_REGISTRATION_MODE=direct
OYAFIND_LOCAL_REGISTRATION_WITHOUT_VERIFICATION=true
# OYAFIND_LISTING_SUBMISSION=
# OYAFIND_LOCATION_CATALOGUE=
# OYAFIND_NOTIFICATIONS=

# Public listing publication policy. Discovery stays closed until every value
# below is set deliberately. Reviewer and verifier ids are database user ids;
# ids must differ, and both accounts must be active with an allowed role.
# OYAFIND_PUBLIC_DISCOVERY_ENABLED=true
# OYAFIND_PUBLIC_STAFF_REVIEW_ACTION=staff_approved_ingested_listing
# OYAFIND_PUBLIC_STAFF_REVIEWER_IDS=
# OYAFIND_PUBLIC_STAFF_REVIEWER_ROLES=staff,admin
# OYAFIND_PUBLIC_VERIFIER_IDS=
# OYAFIND_PUBLIC_VERIFIER_ROLES=staff,admin
# OYAFIND_PUBLIC_ALLOWED_CHECK_TYPES=source_live,details_match
# OYAFIND_PUBLIC_REQUIRED_CHECK_TYPES=source_live,details_match
# OYAFIND_PUBLIC_REQUIRE_DISTINCT_REVIEWERS=true

# Opportunity ingestion. Feeds only stage candidates for review.
# OYAFIND_INGEST_USER_AGENT="OyaFindBot/1.0 (+https://oyafind.ng/sources)"
# OYAFIND_INGEST_TIMEOUT=20
# OYAFIND_INGEST_EXCERPT_LENGTH=1500
# OYAFIND_INGEST_PER_SOURCE_LIMIT=200

VITE_APP_NAME="${APP_NAME}"
