# Caddy terminates TLS and serves the built public directory.
# Certificates come from Let's Encrypt automatically once DNS points here.

{
	email {$ACME_EMAIL}
	admin off
}

{$APP_DOMAIN} {
	root * /var/www/html/public

	# Canonical host below redirects www here, so links never fork.

	encode zstd gzip

	# Vite emits content-hashed filenames under /build, so these are safe to
	# cache for a year. Everything else keeps Caddy's default behaviour.
	@immutable path /build/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Hands .php requests to PHP-FPM and falls back to public/index.php, which
	# is what Laravel's router expects.
	php_fastcgi app:9000

	# php_fastcgi only hands PHP requests to FPM; without this the built
	# assets under /build would be sent to PHP and 404.
	file_server

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		X-Permitted-Cross-Domain-Policies none
	}

	# A browser should never guess a type, and PHP must not be reachable
	# through any path other than the front controller.
	#
	# Dotfiles are never public: .env, .git, .htaccess and friends are all
	# refused. Caddy answers ACME challenges from its own automation handler
	# before site routes run, so /.well-known is not affected by this rule.
	@hidden path_regexp hidden (^|/)\.
	respond @hidden 404

	# Repository and runtime directories. These live above the document root
	# today, so this is defence in depth for a misconfigured root.
	@internal path_regexp internal ^/(vendor|storage|bootstrap|database|tests|deploy|node_modules)(/|$)
	respond @internal 404

	# Build and repository metadata that should never be downloadable.
	@metadata path_regexp metadata ^/(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml(\.dist)?|Dockerfile|docker-compose\.ya?ml|README\.md|AGENTS\.md)$
	respond @metadata 404

	log {
		output stdout
		format console
	}
}

# The www host exists only so www.oyafind.com.ng works when someone types it.
# It keeps its own certificate and permanently redirects to the apex host.
www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent

	log {
		output stdout
		format console
	}
}
