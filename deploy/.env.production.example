# OyaFind production environment.
#
# Copy to .env in this directory and fill in the values, or let
# provision-oracle.sh generate one. Never commit the filled-in file.
#
# Compose also reads this file for ${...} interpolation, so values must be
# plain (no surrounding quotes) and must not contain a literal "#" or "$".

###############################################################################
# Application
###############################################################################
APP_NAME=OyaFind
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://oyafind.com.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

# Consumed by Caddy, not by Laravel.
APP_DOMAIN=oyafind.com.ng
ACME_EMAIL=admin@oyafind.com.ng

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
# Daily files keep a small VM from filling its disk.
LOG_STACK=daily
LOG_LEVEL=warning

###############################################################################
# Database
#
# DB_HOST is set to "mysql" by compose; leave it alone.
# The provisioning script replaces the three CHANGE_ME values.
###############################################################################
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=oyafind
DB_USERNAME=oyafind
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

###############################################################################
# Session, cache, queue
#
# The queue stays synchronous: nothing in this build is queued, so no worker
# container is needed. The scheduler uses the file cache for its overlap locks.
###############################################################################
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

###############################################################################
# Behind Caddy
#
# Without this Laravel generates http:// links and drops the client IP.
# "*" is safe here because the app container is not published to the internet.
###############################################################################
TRUSTED_PROXIES=*

###############################################################################
# Mail
#
# Only needed for OYAFIND_REGISTRATION_MODE=email_verification. `direct` mode
# creates active accounts with an unverified contact and sends no mail.
# Free tiers that work from a VPS include Brevo (300/day) and Resend.
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@oyafind.com.ng"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Feature policies
#
# Every switch fails closed. Turn registration on only after mail works, and
# turn listing submission on only when you are ready to moderate submissions.
###############################################################################
OYAFIND_ACCOUNT_REGISTRATION=true
OYAFIND_REGISTRATION_MODE=direct
OYAFIND_LOCAL_REGISTRATION_WITHOUT_VERIFICATION=false
OYAFIND_LISTING_SUBMISSION=false
OYAFIND_LOCATION_CATALOGUE=true
OYAFIND_NOTIFICATIONS=false

# Password for the administrator created by `db:seed` on first run.
# Replace CHANGE_ME before seeding, then rotate it after the first sign-in.
OYAFIND_SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Password for the separate verifier account created alongside the admin.
# Publishing requires two different allowlisted accounts, so this second
# account must exist before any listing can go live.
OYAFIND_SEED_VERIFIER_PASSWORD=CHANGE_ME_VERIFIER_PASSWORD

###############################################################################
# Public listing publication policy
#
# Discovery stays closed until every value is set deliberately. Reviewer and
# verifier ids are database user ids; they must differ, and both accounts must
# be active with an allowed role.
#
# The ids below are placeholders. After seeding, the administrator is user 1.
# Create a second staff account, note both ids, then set them here.
###############################################################################
OYAFIND_PUBLIC_DISCOVERY_ENABLED=true
OYAFIND_PUBLIC_STAFF_REVIEW_ACTION=staff_approved_ingested_listing
OYAFIND_PUBLIC_STAFF_REVIEWER_IDS=1
OYAFIND_PUBLIC_STAFF_REVIEWER_ROLES=staff,admin
OYAFIND_PUBLIC_VERIFIER_IDS=
OYAFIND_PUBLIC_VERIFIER_ROLES=staff,admin
OYAFIND_PUBLIC_ALLOWED_CHECK_TYPES=source_live,details_match
OYAFIND_PUBLIC_REQUIRED_CHECK_TYPES=source_live,details_match
OYAFIND_PUBLIC_REQUIRE_DISTINCT_REVIEWERS=true

###############################################################################
# Ingestion
#
# Feeds only stage candidates for review. Nothing publishes without a human.
###############################################################################
OYAFIND_INGEST_USER_AGENT="OyaFindBot/1.0 (+https://oyafind.com.ng/sources)"
OYAFIND_INGEST_TIMEOUT=20
OYAFIND_INGEST_EXCERPT_LENGTH=1500
OYAFIND_INGEST_PER_SOURCE_LIMIT=200

VITE_APP_NAME="${APP_NAME}"
